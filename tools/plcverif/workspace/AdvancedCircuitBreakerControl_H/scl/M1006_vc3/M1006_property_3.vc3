-description = "Ensure that if PP3 is true at the end of the cycle and neither PP0 nor PPL3 is true, MCB_CONTROL should be set to 1."
-id = verify_v2_H_3_property_3
-job = verif
-job.backend = nusmv
-job.backend.algorithm = Ic3
-job.backend.binary_path = "/home/mkabir/Desktop/mutate/tools/plcverif/tools/nuxmv/nuXmv-2.2.0-linux64/usr/local/bin/nuXmv"
-job.backend.timeout = 60
-job.req = pattern
-job.req.pattern_id = pattern-implication
-job.req.pattern_params.1 = "instance.PP3 AND NOT (instance.PP0 OR instance.PPL3)"
-job.req.pattern_params.2 = "instance.MCB_CONTROL = TRUE"
-job.reporters.0 = plaintext
-lf = step7
-lf.compiler = Step7v55
-lf.entry = FB_AdvancedCircuitBreakerControl
