-description = "Ensure that if PP2, PP3, or PPL3 is true at the end of the cycle, E_AL1_B1 should be set to 0."
-id = verify_v2_H_3_property_2
-job = verif
-job.backend = nusmv
-job.backend.algorithm = Ic3
